{
  "name": "sports-commentary-service",
  "version": "1.0.0",
  "description": "Real-Time Sports Commentary Service: SSE streaming, concurrent polling workers, global rate limiting and per-worker circuit breakers.",
  "license": "MIT",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "mock": "tsx src/mock/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand --detectOpenHandles=false",
    "test:watch": "jest --watch --runInBand",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
